{
  "name": "@felixfoster/pi-transcript",
  "version": "0.1.0",
  "description": "Read your full Pi conversation after compaction, without patching model context or session internals.",
  "type": "module",
  "license": "MIT",
  "author": "FelixFoster",
  "repository": { "type": "git", "url": "https://github.com/FelixFoster/pi-transcript.git" },
  "homepage": "https://github.com/FelixFoster/pi-transcript#readme",
  "bugs": { "url": "https://github.com/FelixFoster/pi-transcript/issues" },
  "keywords": ["pi-package", "pi-extension", "transcript", "history", "compaction"],
  "engines": { "node": ">=22.19.0" },
  "files": ["src/", "docs/", "README.md", "README.zh-CN.md", "LICENSE", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
}
